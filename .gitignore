# ZH: 手寫的 Windows 資源檔(exe 圖示/版本)，不可忽略 | EN: hand-written Windows resource (exe icon/version) — keep tracked
!resources/app.rc
/.qmake.cache
/.qmake.stash

# qtcreator generated files
*.pro.user*
*.qbs.user*
CMakeLists.txt.user*

# xemacs temporary files
*.flc

# Vim temporary files
.*.swp

# Visual Studio generated files
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*

# MinGW generated files
*.Debug
*.Release

# Python byte code
*.pyc

# Binaries
# --------
*.dll
*.exe

# Directories with generated files
.moc/
.obj/
.pch/
.rcc/
.uic/
/build*/

# ZH: 打包產物 | EN: packaging output
/dist/
/tools/Output/

# ZH: 第三方 SDK (如 Live2D Cubism，體積大且含授權，自行下載放置)
# EN: third-party SDKs (e.g. Live2D Cubism) — large + licensed, downloaded locally
/third_party/

# --- 桌寵專案 & AI 引擎 擴充建議 ---

# AI 模型與權重檔案 (通常體積過大，不建議進 Git)
*.onnx
*.pth
*.bin
*.model
*.weights
*.safetensors
*.ckpt

# 資料集與訓練紀錄
/datasets/
/logs/
/checkpoints/
/ai_server/models/
/resources/images/record/

# Python 相關 (如果你用 Python 訓練 AI)
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# CMake 額外產生的暫存檔
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt